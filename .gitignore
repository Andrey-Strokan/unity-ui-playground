# Jetbrains Rider plugin generated #
# ================================ #
/[Aa]ssets/Plugins/Editor/JetBrains*

# ============ #
# OS generated #
# ============ #
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============= #
# User settings #
# ============= #
src/*/UserSettings

# =========== #
# Git version #
# =========== #
GitVersion.asset
GitVersion.asset.meta

# ===================================================================================== #
# UserWorkspace is private folder for user. Its containment is ignored by project repo. #
# It is useful to store tools and editor extension which is convenient                  #
# for you but could be inconvenient or not required for other contributors.             #
# ===================================================================================== #
!src/*/Assets/UserWorkspace
src/*/Assets/UserWorkspace/*
!src/*/Assets/UserWorkspace/.gitkeep
!src/*/Assets/UserWorkspace/Keystores
src/*/Assets/UserWorkspace/Keystores/*
!src/*/Assets/UserWorkspace/Keystores/KeystoreLink.txt

# ================= #
# Exlude docs build #
# ================= #
/docs/build

# ================= #
# Exlude builds     #
# ================= #
/src/*/Build
/scripts/CI/invoke.yaml
