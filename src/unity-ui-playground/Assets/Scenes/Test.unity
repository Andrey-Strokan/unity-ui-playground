  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PageViewModel
  uiDocument: {fileID: 1041151318}
  paginationModel:
    Pages:
    - Title: Power Drill
      Subtitle: Overview
      Content: "A power drill is an electric tool designed for drilling \nholes into
        various materials such as wood, metal,\nor plastic. It can also be used for
        driving screws when \nequipped with the right bit. Power drills are available\nin
        both corded and cordless models and are commonly \nused in woodworking, construction,
        and DIY projects."
      Image: {fileID: -24690104107724484, guid: fc91e5b4d876a284bb9d85e850a903a1, type: 3}
    - Title: Wrench and Ratchet
      Subtitle: Overview
      Content: "A wrench and ratchet are manual tools used to tighten or loosen bolts,
        nuts,\nand other fasteners.\n\n  - A wrench provides a fixed grip on the
        bolt head or nut, allowing you to turn it by hand.\n    \n  - A ratchet,
        on the other hand, uses a gear-and-socket mechanism that allows continuous\n   
        tightening or loosening without removing the tool from the bolt.\n\nBoth
        are commonly used in woodworking, metalwork, and mechanical assembly tasks\nwhere
        secure fastening is required.\n"
      Image: {fileID: 21300000, guid: fe53817ad5b7aa3408cfb61871600c67, type: 3}
