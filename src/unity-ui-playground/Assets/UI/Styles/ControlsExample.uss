.controls-example {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
    border-radius: var(--border-radius-large);
    padding: 24px;
}

.controls-example__title {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}

.controls-example__caption {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-top: 12px;
}

.controls-example__horizontal-group {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
    align-content: center;
    align-items: flex-start;
}

.controls-example__element-container {
    margin-top: 12px;
    height: 48px;
}

.controls-example__long-button {
    width: 190px;
    height: 48px;
    margin-right: 12px;
}

.controls-example__short-button {
    width: 48px;
    height: 48px;
}
