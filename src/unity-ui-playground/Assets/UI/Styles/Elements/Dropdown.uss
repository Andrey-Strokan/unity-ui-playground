.drop-down-base {
    width: 100%;
    height: 100%;
}

.drop-down-base #DropdownField {
    width: 100%;
    height: 100%;
    margin: 0;
    border-width: 0;
    border-radius: var(--border-radius-medium);
}

.drop-down-base #DropdownField .unity-base-popup-field__text {
    -unity-text-align: middle-center;
}

.drop-down-base #DropdownField .unity-base-popup-field__input {
    background-color: var(--color-primary);
    border-radius: var(--border-radius-medium);
    border-width: 0;
}

.drop-down-base #DropdownField .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-text-on-primary);
}

.drop-down-base #DropdownField:hover .unity-base-popup-field__input {
    background-color: var(--color-primary-variant);
    border-width: 0;
}

.drop-down-base .unity-base-dropdown .unity-scroll-view {
    background-color: var(--color-surface);
    color: var(--color-text-on-surface);
    font-size: 24px;
    border-width: 0;
    border-radius: var(--border-radius-medium);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.drop-down-base #DropdownField .unity-base-dropdown__checkmark {
    align-self: auto;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}
