.content-parent {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
}

.content-child {
    display: flex;
    width: auto;
    height: auto;
    align-items: center;
    justify-content: center;
    padding: 32px 48px 32px 48px;
}

.background-main {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius);
    background-color: var(--surface-dark-tertiary);
}

.text-area-background {
    background-color: var(--surface-dark-tertiary);
    border-radius: var(--border-radius);
    padding: 32px;
    width: 100%;
    height: 100%;
}
