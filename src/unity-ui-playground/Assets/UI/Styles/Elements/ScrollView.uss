.scroll-view {
    width: 300px;
    height: 275px;
    background-color: var(--color-surface);
    border-radius: var(--border-radius-large);
    padding: 24px;
}

.scroll-view__header-text {
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}

.scroll-view__content-text {
}

.scroll-view__divider {
    width: 100%;
    height: 5px;
    margin-top: 12px;
    margin-bottom: 12px;
    background-color: var(--color-text-on-surface);
    border-radius: var(--border-radius-small);
}

/* Override default ScrollView styles */

ScrollView #unity-dragger {
    background-color: var(--color-primary);
    border-radius: var(--border-radius-small);
}

ScrollView #unity-tracker {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

ScrollView #unity-low-button {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--color-primary);
}

ScrollView #unity-high-button {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--color-primary);
}

ScrollView .unity-scroll-view__vertical-scroller #unity-drag-container {
    min-width: 50%;
    align-self: center;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-drag-container {
    align-self: center;
    min-height: 50%;
}

ScrollView .unity-scroll-view__vertical-scroller #unity-dragger {
    min-width: 6px;
    max-width: 6px;
}

ScrollView .unity-scroll-view__horizontal-scroller #unity-dragger {
    min-height: 6px;
    max-height: 6px;
}
