.toggle-base {
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: var(--border-radius-medium);
}

.toggle-base Toggle .unity-toggle__text {
    min-width: 100%;
    max-width: 100%;
    max-height: 100%;
    min-height: 100%;
    position: absolute;
    -unity-text-align: middle-center;
}

.toggle-base Toggle:checked .unity-toggle__text {
    color: var(--color-text-on-secondary);
}

.toggle-base Toggle:active .unity-toggle__text {
    color: var(--color-text-on-secondary);
}

.toggle-base Toggle {
    margin: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius-medium);
}

.toggle-base Toggle #unity-checkmark {
    background-image: none;
    background-color: var(--color-primary);
    border-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: var(--border-radius-medium);
}

.toggle-base Toggle:hover #unity-checkmark {
    background-image: none;
    background-color: var(--color-primary-variant);
}

.toggle-base Toggle:checked #unity-checkmark {
    background-image: none;
    background-color: var(--color-secondary);
}

.toggle-base Toggle:active #unity-checkmark {
    background-image: none;
    background-color: var(--color-secondary-variant);
}
