.theme-switch {
    background-color: var(--color-surface);
    width: 100%;
    height: 100%;
    border-radius: var(--border-radius-large);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.theme-switch__toggle {
    width: 100%;
    height: 100%;
}
