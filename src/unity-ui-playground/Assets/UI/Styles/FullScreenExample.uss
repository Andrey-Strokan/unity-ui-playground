.full-screen-example {
    background-color: var(--color-surface);
    width: 100%;
    height: 100%;
}



.full-screen-example__modal {
    max-width: 350px;
}

.full-screen-example__theme-switch {
    max-width: 350px;
    height: 96px;
}

.full-screen-example__controls {
    max-width: 350px;
    height: auto;
    margin-top: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
    margin-left: 24px;
}

.full-screen-example__horizontal-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 211, 0);
    border-right-color: rgb(255, 211, 0);
    border-top-color: rgb(255, 211, 0);
    border-bottom-color: rgb(255, 211, 0);
}

.full-screen-example__vertical-container {
    flex-direction: column;
    max-width: 350px;
    min-height: 450px;
    margin-top: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
    margin-left: 24px;
    justify-content: space-around;
}
